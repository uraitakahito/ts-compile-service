{
  "version": "1.0",
  "sources": ["model"],
  "maven": {
    "dependencies": [
      "software.amazon.smithy:smithy-aws-traits:1.73.0",
      "software.amazon.smithy:smithy-validation-model:1.73.0",
      "software.amazon.smithy:smithy-openapi:1.73.0",
      "software.amazon.smithy.typescript:smithy-typescript-codegen:0.53.0",
      "software.amazon.smithy.typescript:smithy-aws-typescript-codegen:0.53.0"
    ]
  },
  "plugins": {
    "typescript-codegen": {
      "modes": ["server"],
      "service": "ts.compile#TsCompile",
      "package": "@ts-compile-service/ssdk",
      "packageVersion": "0.0.1"
    },
    "openapi": {
      "service": "ts.compile#TsCompile",
      "protocol": "aws.protocols#restJson1",
      "version": "3.1.0"
    }
  },
  "projections": {
    "client": {
      "plugins": {
        "typescript-codegen": {
          "modes": ["client"],
          "service": "ts.compile#TsCompile",
          "package": "@uraitakahito/ts-compile-client",
          "packageVersion": "0.0.0"
        }
      }
    }
  }
}
