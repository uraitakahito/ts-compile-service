{
    "openapi": "3.1.0",
    "info": {
        "title": "ts-compile-service",
        "version": "2026-09-23",
        "description": "TypeScript を型検査して JavaScript にする。型が通らなければ 1 本も返さない。"
    },
    "paths": {
        "/compile": {
            "post": {
                "description": "capture-ledger が送った TS を、BrowserHive が評価する JS にする。1 段に 1 回。",
                "operationId": "Compile",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CompileRequestContent"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "Compile 200 response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CompileResponseContent"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "ValidationException 400 response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationExceptionResponseContent"
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "SourceHashMismatch 409 response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SourceHashMismatchResponseContent"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "CompileFailed 422 response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CompileFailedResponseContent"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/healthz": {
            "get": {
                "description": "起きているか。何で変換するか（typescript の版と、写した受け皿の型の tag）。",
                "operationId": "GetHealth",
                "responses": {
                    "200": {
                        "description": "GetHealth 200 response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/GetHealthResponseContent"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "ValidationException 400 response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationExceptionResponseContent"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "CompileFailedResponseContent": {
                "type": "object",
                "description": "1 本でも型か決まりが通らなかった。1 本も返さない。",
                "properties": {
                    "message": {
                        "type": "string"
                    },
                    "typescript": {
                        "type": "string"
                    },
                    "diagnostics": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Diagnostic"
                        }
                    },
                    "declarations": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Declaration"
                        },
                        "description": "スクリプトごとの変数の宣言。型が通らなくても読める物は読む"
                    },
                    "missingVariables": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "maxLength": 64,
                            "minLength": 1,
                            "pattern": "^[a-z][a-z0-9_]*$",
                            "description": "変数の名前。capture-ledger の schema と BrowserHive の ValueName と同じ式"
                        },
                        "maxItems": 32,
                        "minItems": 0,
                        "description": "必須の宣言のうち、variableNames に無かった名前"
                    }
                },
                "required": [
                    "declarations",
                    "diagnostics",
                    "message",
                    "missingVariables",
                    "typescript"
                ]
            },
            "CompileRequestContent": {
                "type": "object",
                "properties": {
                    "scripts": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Script"
                        },
                        "maxItems": 100,
                        "minItems": 0,
                        "description": "0 本も通す。capture-ledger は `scriptIds: []` を「何も走らせない」という意思として受理し、空でも段に載せる ——\nそれを断るのは model の見落とし。空なら何も変換せず、200 で `scripts: []` を返す（typescript と hostTypes は付く）"
                    },
                    "variableNames": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "maxLength": 64,
                            "minLength": 1,
                            "pattern": "^[a-z][a-z0-9_]*$",
                            "description": "変数の名前。capture-ledger の schema と BrowserHive の ValueName と同じ式"
                        },
                        "maxItems": 32,
                        "minItems": 0,
                        "description": "このクロールに渡された変数の名前。値は送らない。必須の宣言と照らし、足りなければ 422（BH0001）。\nJS は source だけで決まるので、cache の鍵には入らない"
                    }
                },
                "required": [
                    "scripts",
                    "variableNames"
                ]
            },
            "CompileResponseContent": {
                "type": "object",
                "properties": {
                    "typescript": {
                        "type": "string",
                        "description": "何で変換したか（typescript の版）"
                    },
                    "hostTypes": {
                        "type": "string",
                        "description": "何に向けて変換したか（写した受け皿の型の tag。GetHealth と同じ値）。\n報告に載せるのに、クロールの段ごとに healthz を訊かせない"
                    },
                    "scripts": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Script"
                        },
                        "maxItems": 100,
                        "minItems": 0,
                        "description": "入力と同じ形。source と sha256 だけ JS になる"
                    },
                    "cached": {
                        "type": "boolean",
                        "description": "同じ TS の並びを前にも変換していたか"
                    },
                    "declarations": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Declaration"
                        },
                        "description": "スクリプトごとの変数の宣言（defineParams）。入力と同じ並び"
                    }
                },
                "required": [
                    "cached",
                    "declarations",
                    "hostTypes",
                    "scripts",
                    "typescript"
                ]
            },
            "Declaration": {
                "type": "object",
                "description": "1 本のスクリプトの変数の宣言",
                "properties": {
                    "id": {
                        "type": "string",
                        "maxLength": 64,
                        "minLength": 1,
                        "pattern": "^[a-z][a-z0-9-]*$"
                    },
                    "params": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/DeclaredParam"
                        }
                    },
                    "unreadable": {
                        "type": "boolean",
                        "description": "宣言を読めなかった（BH0002）。params は当てにならない"
                    }
                },
                "required": [
                    "id",
                    "params",
                    "unreadable"
                ]
            },
            "DeclaredParam": {
                "type": "object",
                "description": "宣言された変数 1 つ。値は文字列だけ",
                "properties": {
                    "name": {
                        "type": "string",
                        "maxLength": 64,
                        "minLength": 1,
                        "pattern": "^[a-z][a-z0-9_]*$",
                        "description": "変数の名前。capture-ledger の schema と BrowserHive の ValueName と同じ式"
                    },
                    "kind": {
                        "$ref": "#/components/schemas/ParamKind"
                    },
                    "required": {
                        "type": "boolean"
                    },
                    "summary": {
                        "type": "string",
                        "description": ".describe(\"…\") の字"
                    },
                    "schema": {
                        "$ref": "#/components/schemas/ParamSchema"
                    }
                },
                "required": [
                    "kind",
                    "name",
                    "required",
                    "schema"
                ]
            },
            "Diagnostic": {
                "type": "object",
                "properties": {
                    "file": {
                        "type": "string"
                    },
                    "line": {
                        "type": "number"
                    },
                    "col": {
                        "type": "number"
                    },
                    "code": {
                        "type": "string",
                        "description": "TypeScript の誤りは TS2322 のような code。この service の決まりは BH0001（必須の変数が渡されていない）・\nBH0002（defineParams の宣言を読めない）・BH0003（import の形）・BH0004（preload の import か defineParams）・\nBH0005（__bh.vars の直読み）・BH0006（classic script として読めない）"
                    },
                    "message": {
                        "type": "string"
                    }
                },
                "required": [
                    "code",
                    "message"
                ]
            },
            "GetHealthResponseContent": {
                "type": "object",
                "properties": {
                    "ok": {
                        "type": "boolean"
                    },
                    "typescript": {
                        "type": "string"
                    },
                    "hostTypes": {
                        "type": "string",
                        "description": "写した capture-scripts の tag（capture-scripts.pin の中身）"
                    }
                },
                "required": [
                    "hostTypes",
                    "ok",
                    "typescript"
                ]
            },
            "ParamKind": {
                "type": "string",
                "enum": [
                    "variable"
                ]
            },
            "ParamSchema": {
                "type": "object",
                "description": "値の JSON Schema。鍵はこの 4 つだけ",
                "properties": {
                    "type": {
                        "type": "string"
                    },
                    "minLength": {
                        "type": "number"
                    },
                    "maxLength": {
                        "type": "number"
                    },
                    "enum": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                "required": [
                    "type"
                ]
            },
            "Phase": {
                "type": "string",
                "enum": [
                    "preload",
                    "behavior"
                ]
            },
            "Script": {
                "type": "object",
                "description": "スクリプト 1 本。capture-ledger が送る形そのもの。",
                "properties": {
                    "id": {
                        "type": "string",
                        "maxLength": 64,
                        "minLength": 1,
                        "pattern": "^[a-z][a-z0-9-]*$"
                    },
                    "version": {
                        "type": "number"
                    },
                    "phase": {
                        "$ref": "#/components/schemas/Phase"
                    },
                    "source": {
                        "type": "string"
                    },
                    "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$",
                        "description": "source のバイト列の sha256（hex）"
                    },
                    "options": {}
                },
                "required": [
                    "id",
                    "phase",
                    "sha256",
                    "source",
                    "version"
                ]
            },
            "SourceHashMismatchResponseContent": {
                "type": "object",
                "description": "送られた sha256 が source と合わない。運ぶ途中で入れ替わった物は変換しない。",
                "properties": {
                    "message": {
                        "type": "string"
                    },
                    "id": {
                        "type": "string",
                        "maxLength": 64,
                        "minLength": 1,
                        "pattern": "^[a-z][a-z0-9-]*$"
                    }
                },
                "required": [
                    "id",
                    "message"
                ]
            },
            "ValidationExceptionField": {
                "type": "object",
                "description": "Describes one specific validation failure for an input member.",
                "properties": {
                    "path": {
                        "type": "string",
                        "description": "A JSONPointer expression to the structure member whose value failed to satisfy the modeled constraints."
                    },
                    "message": {
                        "type": "string",
                        "description": "A detailed description of the validation failure."
                    }
                },
                "required": [
                    "message",
                    "path"
                ]
            },
            "ValidationExceptionResponseContent": {
                "type": "object",
                "description": "A standard error for input validation failures.\nThis should be thrown by services when a member of the input structure\nfalls outside of the modeled or documented constraints.",
                "properties": {
                    "message": {
                        "type": "string",
                        "description": "A summary of the validation failure."
                    },
                    "fieldList": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ValidationExceptionField"
                        },
                        "description": "A list of specific failures encountered while validating the input.\nA member can appear in this list more than once if it failed to satisfy multiple constraints."
                    }
                },
                "required": [
                    "message"
                ]
            }
        }
    }
}
